#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
key_file="$HOME/.config/sops/age/keys.txt"

if [[ ! -s "$key_file" ]]; then
  echo "No age key at $key_file; secrets will not decrypt on this host." >&2
  echo "See \"Secrets\" in $repo_root/README.md for adding a host." >&2
  exit 1
fi

# Fetch every input, including the private nix-secrets repo, as this user. darwin-rebuild runs as
# root, which has no GitHub credentials, and reuses the locked inputs already in the store.
nix flake archive "$repo_root" >/dev/null

case "$(uname -s):${1:-rebuild}" in
  # --sudo evaluates and builds as this user and elevates only to activate; root would refuse to
  # read a git checkout it doesn't own.
  Linux:rebuild) exec nixos-rebuild switch --sudo --flake "$repo_root" ;;
  Linux:nh) exec nh os switch "$repo_root" ;;
  Darwin:rebuild) exec sudo darwin-rebuild switch --flake "$repo_root" ;;
  Darwin:nh) exec nh darwin switch "$repo_root" ;;
  *) echo "Unsupported platform or switch mode." >&2; exit 1 ;;
esac
