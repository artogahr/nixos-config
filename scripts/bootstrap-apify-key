#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
encrypted_key="$repo_root/secrets/apify-age-key.age"
key_dir="$HOME/.config/sops/age"
key_file="$key_dir/keys.txt"
expected_public_key="age1dcyqzvw02qwx0ea4wfjy5jr6cswm4yt6rtj8dayv8fpspfcp2upslkjndy"

if ! command -v age >/dev/null || ! command -v age-keygen >/dev/null; then
  echo "Run with: nix shell nixpkgs#age --command bash scripts/bootstrap-apify-key" >&2
  exit 1
fi

if [[ -e "$key_file" ]]; then
  if [[ "$(age-keygen -y "$key_file")" == "$expected_public_key" ]]; then
    echo "Age key is already installed."
    exit 0
  fi
  echo "An unrelated age key already exists at $key_file." >&2
  exit 1
fi

umask 077
mkdir -p "$key_dir"
chmod 700 "$key_dir"
temporary_key="$(mktemp "$key_dir/.keys.txt.XXXXXX")"
trap 'rm -f "$temporary_key"' EXIT

age --decrypt "$encrypted_key" > "$temporary_key"
if [[ "$(age-keygen -y "$temporary_key")" != "$expected_public_key" ]]; then
  echo "The decrypted key does not match this repository." >&2
  exit 1
fi

chmod 600 "$temporary_key"
mv "$temporary_key" "$key_file"
echo "Age key installed at $key_file. You can now switch this host."
